{
  "$description": "PunchPace design tokens (W3C Design Tokens format). primitive: the palette and the scales. theme: what each colour is for; the app only uses these. A light theme maps the same theme names onto other primitives. npm run tokens writes tokens.css from this file; see design/README.md for the rules.",
  "primitive": {
    "color": {
      "$type": "color",
      "ink": {
        "900": { "$value": "#171717", "$description": "Brand ink: page background, text on bright colours" },
        "800": { "$value": "#21201f" },
        "700": { "$value": "#33312e" }
      },
      "paper": { "$value": "#f2efe3", "$description": "Brand warm off-white" },
      "black": { "$value": "#000000" },
      "orange": {
        "500": { "$value": "#ff4b16", "$description": "Brand punch orange" },
        "400": { "$value": "#ff6838" }
      },
      "red": {
        "900": { "$value": "#3a2020" },
        "300": { "$value": "#e06c6c" },
        "400": { "$value": "#ff6b77" },
        "500": { "$value": "#ff4d5e" }
      },
      "blue": { "$value": "#4d94ff" },
      "sky": { "$value": "#5e9fe8" },
      "green": { "$value": "#3ddc84" },
      "moss": { "$value": "#46a171" },
      "sage": { "$value": "#9fd4b3" },
      "teal": { "$value": "#22cce0" },
      "yellow": { "$value": "#ffc93c" },
      "amber": { "$value": "#ff9f43" },
      "purple": { "$value": "#a97bff" },
      "violet": { "$value": "#a78bfa" },
      "lavender": { "$value": "#c4b5fd" },
      "periwinkle": { "$value": "#8b9cff" },
      "pink": { "$value": "#ff5caa" },
      "lime": { "$value": "#a3e635" },
      "peach": { "$value": "#fdba74" },
      "orchid": { "$value": "#e879f9" },
      "mint": { "$value": "#5eead4" },
      "rose": { "$value": "#fca5a5" },
      "ice": { "$value": "#93c5fd" },
      "cream": { "$value": "#fde68a" }
    }
  },
  "theme": {
    "color": {
      "$type": "color",
      "bg": { "$value": "{primitive.color.ink.900}", "$description": "Page and input background" },
      "surface": { "$value": "{primitive.color.ink.800}", "$description": "Cards, buttons" },
      "surface-raised": { "$value": "{primitive.color.ink.700}", "$description": "Hover, a lifted card" },
      "text": { "$value": "{primitive.color.paper}" },
      "text-muted": {
        "$value": "{primitive.color.paper}",
        "$extensions": { "alpha": 0.62 },
        "$description": "Secondary text, labels"
      },
      "border": { "$value": "{primitive.color.paper}", "$extensions": { "alpha": 0.15 } },
      "tint-1": {
        "$value": "{primitive.color.paper}",
        "$extensions": { "alpha": 0.06 },
        "$description": "Faint fill on a dark background"
      },
      "tint-2": { "$value": "{primitive.color.paper}", "$extensions": { "alpha": 0.12 } },
      "tint-3": { "$value": "{primitive.color.paper}", "$extensions": { "alpha": 0.28 } },
      "accent": {
        "$value": "{primitive.color.orange.500}",
        "$description": "Main actions, the current thing, brand slash"
      },
      "accent-hover": { "$value": "{primitive.color.orange.400}" },
      "accent-text": {
        "$value": "{primitive.color.orange.400}",
        "$description": "Text in the accent colour: lighter than the accent, so it stays readable on every surface"
      },
      "accent-soft": {
        "$value": "{primitive.color.orange.500}",
        "$extensions": { "alpha": 0.12 },
        "$description": "Background of a note or badge in the accent"
      },
      "accent-line": { "$value": "{primitive.color.orange.500}", "$extensions": { "alpha": 0.3 } },
      "selection": { "$value": "{primitive.color.orange.500}", "$extensions": { "alpha": 0.4 } },
      "on-accent": {
        "$value": "{primitive.color.ink.900}",
        "$description": "Text and icons on the accent, a routine colour or a step colour"
      },
      "focus": { "$value": "{primitive.color.orange.500}" },
      "success": { "$value": "{primitive.color.green}", "$description": "Done, matches" },
      "warning": { "$value": "{primitive.color.orange.400}", "$description": "Text: needs attention, still works" },
      "danger": { "$value": "{primitive.color.red.500}", "$description": "Fill: errors" },
      "danger-text": { "$value": "{primitive.color.red.400}", "$description": "Text: delete, errors" },
      "danger-surface": { "$value": "{primitive.color.red.900}" },
      "danger-border": { "$value": "{primitive.color.red.300}" },
      "notice": { "$value": "{primitive.color.yellow}", "$description": "Account messages" },
      "shadow": { "$value": "{primitive.color.black}", "$extensions": { "alpha": 0.5 } },
      "scrim": {
        "$value": "{primitive.color.black}",
        "$extensions": { "alpha": 0.6 },
        "$description": "Behind a dialog"
      },
      "logo-word": { "$value": "{primitive.color.paper}", "$description": "Logo: the light parts" },
      "logo-mark": { "$value": "{primitive.color.orange.500}", "$description": "Logo: the orange parts" },
      "heat": {
        "$description": "History heatmap: workouts per day, none to most",
        "0": { "$value": "{primitive.color.paper}", "$extensions": { "alpha": 0.06 } },
        "1": { "$value": "{primitive.color.orange.500}", "$extensions": { "alpha": 0.38 } },
        "2": { "$value": "{primitive.color.orange.500}", "$extensions": { "alpha": 0.68 } },
        "3": { "$value": "{primitive.color.orange.500}" },
        "log": { "$value": "{primitive.color.paper}", "$extensions": { "alpha": 0.28 }, "$description": "Logged only" }
      },
      "step": {
        "$description": "Run screen: work uses the routine's colour",
        "prep": { "$value": "{primitive.color.sky}" },
        "rest": { "$value": "{primitive.color.moss}" },
        "rest-text": { "$value": "{primitive.color.sage}", "$description": "Text on a rest tint" }
      },
      "routine": {
        "$description": "Colours a routine can have (its color field)",
        "orange": { "$value": "{primitive.color.orange.500}" },
        "red": { "$value": "{primitive.color.red.500}" },
        "blue": { "$value": "{primitive.color.blue}" },
        "green": { "$value": "{primitive.color.green}" },
        "purple": { "$value": "{primitive.color.purple}" },
        "yellow": { "$value": "{primitive.color.yellow}" },
        "teal": { "$value": "{primitive.color.teal}" },
        "pink": { "$value": "{primitive.color.pink}" }
      },
      "tone": {
        "$description": "Boxing move tags, the same colour as the move's tone: known moves by id (core/steps.js MOVES), then other moves in order",
        "jab": { "$value": "{primitive.color.blue}" },
        "cross": { "$value": "{primitive.color.red.500}" },
        "lead_hook": { "$value": "{primitive.color.yellow}" },
        "rear_hook": { "$value": "{primitive.color.amber}" },
        "lead_uppercut": { "$value": "{primitive.color.green}" },
        "rear_uppercut": { "$value": "{primitive.color.teal}" },
        "slip": { "$value": "{primitive.color.lavender}" },
        "duck": { "$value": "{primitive.color.violet}" },
        "roll": { "$value": "{primitive.color.periwinkle}" },
        "free-1": { "$value": "{primitive.color.pink}" },
        "free-2": { "$value": "{primitive.color.lime}" },
        "free-3": { "$value": "{primitive.color.peach}" },
        "free-4": { "$value": "{primitive.color.orchid}" },
        "free-5": { "$value": "{primitive.color.mint}" },
        "free-6": { "$value": "{primitive.color.rose}" },
        "free-7": { "$value": "{primitive.color.ice}" },
        "free-8": { "$value": "{primitive.color.cream}" }
      }
    },
    "space": {
      "$type": "dimension",
      "$description": "Spacing on a 4px grid; half (2px) only for fine alignment",
      "half": { "$value": "2px" },
      "1": { "$value": "4px" },
      "2": { "$value": "8px" },
      "3": { "$value": "12px" },
      "4": { "$value": "16px" },
      "5": { "$value": "20px" },
      "6": { "$value": "24px" },
      "16": { "$value": "64px" }
    },
    "fontSize": {
      "$type": "dimension",
      "$description": "Type scale. 12px only for captions and small caps labels; body text is 16px",
      "xs": { "$value": "12px" },
      "sm": { "$value": "14px" },
      "md": { "$value": "16px" },
      "lg": { "$value": "18px" },
      "xl": { "$value": "20px" },
      "2xl": { "$value": "24px" },
      "3xl": { "$value": "28px" }
    },
    "radius": {
      "$type": "dimension",
      "sm": { "$value": "4px", "$description": "Tags, small marks" },
      "md": { "$value": "8px", "$description": "Buttons, inputs" },
      "lg": { "$value": "12px", "$description": "Cards, dialogs" },
      "pill": { "$value": "999px", "$description": "Chips" },
      "round": { "$value": "50%", "$description": "Circles" }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms", "$description": "Press feedback" },
      "base": { "$value": "150ms", "$description": "Moves, reordering" },
      "slow": { "$value": "200ms", "$description": "Progress" }
    },
    "font": {
      "$type": "fontFamily",
      "display": {
        "$value": ["Saira", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Headings, numbers, buttons (italic)"
      },
      "body": { "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"] }
    }
  }
}
